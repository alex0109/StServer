PROMETHEUS_URL=""
PROMETHEUS_USER=""
PROMETHEUS_TOKEN=""
GRAFANA_URL=""
GRAFANA_TOKEN=""
SENTRY_API_URL="https://de.sentry.io"
SENTRY_ORG="reybey-org"
SENTRY_API_TOKEN=""
GA_PROPERTY_ID=""
GA_CREDENTIALS_JSON=""

# Payments (Stripe). Off until the key, the webhook secret and at least one price are set
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
# managed (Stripe is the merchant of record and handles VAT), automatic (Stripe Tax) or none
STRIPE_TAX_MODE="none"
# Optional free trial in days for someone who never paid before
STRIPE_TRIAL_DAYS=""
