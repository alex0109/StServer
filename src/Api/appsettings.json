{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Flashcards": {
    "Algorithm": "Fsrs",
    "Fsrs": {
      "DesiredRetention": 0.9,
      "MaximumIntervalDays": 36500,
      "EnableFuzzing": true
    }
  },
  "Ai": {
    "Enabled": true,
    "ProviderOrder": [ "Anthropic", "OpenAi", "Gemini" ],
    "RequestTimeoutSeconds": 120,
    "GradingGrayZoneMin": 40,
    "GradingPassScore": 70,
    "Quotas": {
      "Free": { "QuestionGeneration": 10, "DictionaryGeneration": 5, "AnswerGrading": 30, "SummaryGeneration": 3, "MistakeExplanation": 5 },
      "Plus": { "QuestionGeneration": 100, "DictionaryGeneration": 50, "AnswerGrading": 300, "SummaryGeneration": 30, "MistakeExplanation": 50 },
      "Pro": { "QuestionGeneration": 500, "DictionaryGeneration": 250, "AnswerGrading": 1500, "SummaryGeneration": 150, "MistakeExplanation": 250 }
    }
  },
  "AiProviders": {
    "Anthropic": { "Model": "claude-haiku-5-5" },
    "OpenAi": { "Model": "gpt-5.4-mini" },
    "Gemini": { "Model": "gemini-flash-latest" }
  }
}
