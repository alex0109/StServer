{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Flashcards": {
    "Algorithm": "Fsrs",
    "Fsrs": {
      "DesiredRetention": 0.9,
      "MaximumIntervalDays": 36500,
      "EnableFuzzing": true
    }
  },
  "Ai": {
    "Enabled": true,
    "ProviderOrder": [ "Anthropic", "OpenAi", "Gemini" ],
    "RequestTimeoutSeconds": 120,
    "GradingGrayZoneMin": 40,
    "GradingPassScore": 70,
    "UnusableGracePerDay": 3
  },
  "AiProviders": {
    "Anthropic": { "Model": "claude-haiku-5-5" },
    "OpenAi": { "Model": "gpt-5.4-mini" },
    "Gemini": { "Model": "gemini-flash-latest" }
  },
  "Email": {
    "From": "Studytracker <onboarding@resend.dev>",
    "FeedbackTo": "krossyouyub@gmail.com",
    "AppUrl": "http://localhost:3000"
  },
  "Notifications": {
    "DailyReminderHour": 9,
    "StreakReminderHour": 20,
    "WeeklyDigestDay": "Monday",
    "WeeklyDigestHour": 9
  },
  "Limits": {
    "CountLibraryImports": false,
    "StorageMb": 500
  },
  "Review": { "MaxWordsPerSession": 100, "NewWordsPerSession": 20, "MaxQuestionsPerSession": 30, "SecondsPerWord": 8, "SecondsPerQuestion": 30 },
  "Pricing": {
    "_comment": "USD unless a currency is given. Units: requests; WordLookup words; PodcastGeneration podcasts; VideoTranscript minutes. PricingValidator (unit test and startup) checks every paid plan and credit price stays profitable",
    "FallbackShare": 0.05,
    "StripePercent": 0.024,
    "StripeFixedNok": 2,
    "VatRate": 0.25,
    "NokPerUsd": 10.5,
    "FreeMonthlyCostCap": 0.35,
    "FreeTrialCostCap": 0.40,
    "Features": {
      "QuestionGeneration": { "UnitCost": 0.002, "FallbackUnitCost": 0.016, "Credits": 1, "MaxInputChars": 24000 },
      "AnswerGrading": { "UnitCost": 0.0002, "FallbackUnitCost": 0.002 },
      "MistakeExplanation": { "UnitCost": 0.003, "FallbackUnitCost": 0.02, "Credits": 2 },
      "DictionaryGeneration": { "UnitCost": 0.003, "FallbackUnitCost": 0.024, "Credits": 2 },
      "SummaryGeneration": { "UnitCost": 0.01, "FallbackUnitCost": 0.02, "Credits": 3, "MaxInputChars": 60000 },
      "EssayReview": { "UnitCost": 0.002, "FallbackUnitCost": 0.02, "Credits": 1 },
      "WordLookup": { "UnitCost": 0.0002, "FallbackUnitCost": 0.002, "Credits": 1, "CreditBlock": 10, "SharedCreditBlocks": true },
      "WordExplanation": { "UnitCost": 0.0006, "FallbackUnitCost": 0.005, "Credits": 1 },
      "PodcastGeneration": { "UnitCost": 0.215, "FallbackUnitCost": 0.25, "Credits": 61 },
      "VideoTranscript": { "UnitCost": 0.0045, "Credits": 7, "CreditBlock": 5 }
    },
    "Plans": {
      "Free": {
        "Seats": 1,
        "Quotas": { "QuestionGeneration": 10, "AnswerGrading": 300, "MistakeExplanation": 5, "DictionaryGeneration": 5, "SummaryGeneration": 3, "EssayReview": 3, "WordLookup": 100, "WordExplanation": 100, "PodcastGeneration": 0, "VideoTranscript": 0 },
        "LifetimeTrial": { "PodcastGeneration": 1, "VideoTranscript": 30 }
      },
      "Plus": {
        "Seats": 1,
        "Prices": [ { "Interval": "Month", "Amount": 5, "Currency": "USD" } ],
        "Quotas": { "QuestionGeneration": 100, "AnswerGrading": 1000, "MistakeExplanation": 50, "DictionaryGeneration": 50, "SummaryGeneration": 30, "EssayReview": 30, "WordLookup": 1000, "WordExplanation": 300, "PodcastGeneration": 5, "VideoTranscript": 120 }
      },
      "Duo": {
        "Seats": 2,
        "Prices": [ { "Interval": "Month", "Amount": 10, "Currency": "USD" } ],
        "Quotas": { "QuestionGeneration": 100, "AnswerGrading": 1000, "MistakeExplanation": 50, "DictionaryGeneration": 50, "SummaryGeneration": 30, "EssayReview": 30, "WordLookup": 1000, "WordExplanation": 300, "PodcastGeneration": 5, "VideoTranscript": 120 }
      }
    },
    "Packs": [
      { "Id": "small", "Credits": 250, "Price": 3, "Currency": "USD" },
      { "Id": "medium", "Credits": 500, "Price": 5, "Currency": "USD" },
      { "Id": "large", "Credits": 1050, "Price": 10, "Currency": "USD" }
    ]
  },
  "AiPricing": {
    "CheckedOn": "2026-10-26",
    "Models": {
      "claude-haiku-5-5": { "InputPerMillion": 0.1, "OutputPerMillion": 0.5 },
      "gpt-5.4-mini": { "InputPerMillion": 0.75, "OutputPerMillion": 4.5 },
      "gemini-flash-latest": { "InputPerMillion": 0.75, "OutputPerMillion": 3.75 }
    },
    "SpeechPerMillionCharacters": 15
  }
}
