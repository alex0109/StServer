{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Flashcards": {
    "Algorithm": "Fsrs",
    "Fsrs": {
      "DesiredRetention": 0.9,
      "MaximumIntervalDays": 36500,
      "EnableFuzzing": true
    }
  }
}
