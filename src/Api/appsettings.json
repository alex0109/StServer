{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Flashcards": {
    "Algorithm": "Fsrs",
    "Fsrs": {
      "DesiredRetention": 0.9,
      "MaximumIntervalDays": 36500,
      "EnableFuzzing": true
    }
  },
  "Ai": {
    "Enabled": true,
    "ProviderOrder": [ "Anthropic", "OpenAi", "Gemini" ],
    "RequestTimeoutSeconds": 120,
    "GradingGrayZoneMin": 40,
    "GradingPassScore": 70,
    "Quotas": {
      "Free": { "QuestionGeneration": 10, "DictionaryGeneration": 5, "AnswerGrading": 30, "SummaryGeneration": 3, "MistakeExplanation": 5 },
      "Plus": { "QuestionGeneration": 100, "DictionaryGeneration": 50, "AnswerGrading": 300, "SummaryGeneration": 30, "MistakeExplanation": 50 },
      "Pro": { "QuestionGeneration": 500, "DictionaryGeneration": 250, "AnswerGrading": 1500, "SummaryGeneration": 150, "MistakeExplanation": 250 }
    }
  },
  "AiProviders": {
    "Anthropic": { "Model": "claude-haiku-5-5" },
    "OpenAi": { "Model": "gpt-5.4-mini" },
    "Gemini": { "Model": "gemini-flash-latest" }
  },
  "Email": {
    "From": "Studytracker <onboarding@resend.dev>",
    "FeedbackTo": "krossyouyub@gmail.com",
    "AppUrl": "http://localhost:3000"
  },
  "Notifications": {
    "DailyReminderHour": 9,
    "StreakReminderHour": 20,
    "WeeklyDigestDay": "Monday",
    "WeeklyDigestHour": 9
  },
  "AiPricing": {
    "CheckedOn": "2026-10-26",
    "Models": {
      "claude-haiku-5-5": { "InputPerMillion": 0.1, "OutputPerMillion": 0.5 },
      "gpt-5.4-mini": { "InputPerMillion": 0.75, "OutputPerMillion": 4.5 },
      "gemini-flash-latest": { "InputPerMillion": 0.75, "OutputPerMillion": 3.75 }
    }
  }
}
